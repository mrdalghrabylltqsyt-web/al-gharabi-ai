node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# Netlify uses npm via package-lock.json. A stray Bun lockfile switches Netlify
# to `bun install`, and an empty/invalid one fails the deploy instantly.
bun.lock
bun.lockb

# Runtime server state (may hold encrypted provider tokens and real business data).
.gharabi-state.json
.gharabi-state.json.tmp
.gharabi-usage.json
.gharabi-backups/

# Local preview/runtime env files: may hold the owner email, Resend key, and a
# preview login token. Never commit these.
.gharabi-preview.env
.gharabi-*.local.env
