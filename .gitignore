node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# Netlify uses npm via package-lock.json. A stray Bun lockfile switches Netlify
# to `bun install`, and an empty/invalid one fails the deploy instantly.
bun.lock
bun.lockb

# أرشيفات التصدير/البناء: تحتوي نسخة كاملة من المصدر وتُضخّم المستودع بلا داعٍ.
*.zip

# Runtime server state (may hold encrypted provider tokens and real business data).
.gharabi-state.json
.gharabi-state.json.tmp
.gharabi-usage.json
.gharabi-control.json
.gharabi-control.json.tmp
.gharabi-backups/

# Local preview/runtime env files: may hold the owner email, Resend key, and a
# preview login token. Never commit these.
.gharabi-preview.env
.gharabi-*.local.env

# Local verification tooling (embedded Postgres for testing persistence offline).
# Its native binaries are heavy and never needed in CI or on Render.
tools/local-verification/node_modules/
