# GEMINI_API_KEY: Required for Gemini AI API calls.
# This key stays on the server only. It is never exposed to the frontend bundle.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional preferred model. It is tried first, then the built-in
# fallback candidates are tried in order if the provider rejects the name.
# Leave empty to use the built-in candidates only.
GEMINI_MODEL=

# AI_TIMEOUT_MS: Hard timeout for a single provider request (5000-60000).
AI_TIMEOUT_MS=20000

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OWNER_EMAIL: The verified Google account email of the system owner.
OWNER_EMAIL="mrdalghrabylltqsyt@gmail.com"

# VITE_GOOGLE_CLIENT_ID: Optional Google OAuth Web Client ID for Google Sign-In button
VITE_GOOGLE_CLIENT_ID=""

# Local safety guard only (does not represent provider quota)
GEMINI_DAILY_LIMIT=6
# Optional HMAC secret for verified inbound provider webhooks. Leave empty to disable webhook intake.
WEBHOOK_SECRET=

# Production social provider connections (never put these in frontend code)
APP_URL=https://your-domain.example
PLATFORM_TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
