# GEMINI_API_KEY: Required for Gemini AI API calls.
# This key stays on the server only. It is never exposed to the frontend bundle.
# The browser never talks to Gemini directly; all AI traffic goes through the server.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional preferred model. It is tried first, then the built-in
# Gemini GA candidates are tried in order. Leave empty to use the built-in
# candidates only (recommended).
#
# Shut-down model IDs are rejected automatically and never sent to the provider,
# so a stale value here cannot break AI requests. See engine/ai/models.ts for the
# single source of truth on model IDs.
GEMINI_MODEL=

# AI_TIMEOUT_MS: Hard timeout for a single provider request (5000-60000).
AI_TIMEOUT_MS=20000

# GEMINI_DAILY_LIMIT: Local server-side guard (1-6), NOT the provider quota.
# It only caps how many AI requests this server makes per day.
GEMINI_DAILY_LIMIT=4

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
