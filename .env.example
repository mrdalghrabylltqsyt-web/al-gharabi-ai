# GEMINI_API_KEY: Required for Gemini AI API calls.
# This key stays on the server only. It is never exposed to the frontend bundle.
# The browser never talks to Gemini directly; all AI traffic goes through the server.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional preferred model. It is tried first, then the built-in
# Gemini GA candidates are tried in order. Leave empty to use the built-in
# candidates only (recommended).
#
# Shut-down model IDs are rejected automatically and never sent to the provider,
# so a stale value here cannot break AI requests. See engine/ai/models.ts for the
# single source of truth on model IDs.
GEMINI_MODEL=

# AI_TIMEOUT_MS: Hard timeout for a single provider request (5000-60000).
AI_TIMEOUT_MS=20000

# GEMINI_DAILY_LIMIT: Local server-side guard (1-6), NOT the provider quota.
# It only caps how many AI requests this server makes per day.
GEMINI_DAILY_LIMIT=4

# GEMINI_FREE_TIER_PROTECTION: Central project-wide free-tier firewall (default true).
# One shared budget for every platform (current and future). Set to "false" only to
# disable the strict local guard explicitly; a daily limit still applies either way.
GEMINI_FREE_TIER_PROTECTION=true

# YOUTUBE_COMMENT_SCAN_VIDEO_LIMIT: عدد أحدث الفيديوهات التي تُفحص عند البحث عن
# تعليقات القناة (1..25، الافتراضي 5). يمنع إغفال تعليق حقيقي على فيديو أقدم
# بقليل مع الحفاظ على حدّ آمن لاستدعاءات commentThreads.list.
YOUTUBE_COMMENT_SCAN_VIDEO_LIMIT=5

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OWNER_EMAIL: The single owner account. Only this address can request the
# owner OTP login, and only this address receives it. Lowercase, no spaces.
# Set it to the gallery owner's real mailbox.
OWNER_EMAIL="owner@yourdomain.com"

# SESSION_SECRET: Signs owner/user session tokens. REQUIRED for permanent access.
# With it set, a login survives server restarts, redeploys, and serverless cold
# starts — the owner stays logged in instead of being asked to sign in again.
# Without it, sessions fall back to PLATFORM_TOKEN_ENCRYPTION_KEY, and failing
# that to a per-process random key (sessions then die on every cold start).
# Use a long random value. Server-side only; never expose it to the frontend.
#   generate with: openssl rand -hex 32
SESSION_SECRET="MY_LONG_RANDOM_SESSION_SECRET"

# STATE_DIR: Directory for the persistent state file (.gharabi-state.json) and
# backups. Point it at a persistent/mounted volume so accounts, workspace data,
# and session revocations survive restarts. Defaults to the working directory.
# Note: on hosts with a read-only filesystem the file cannot be written; the
# server reports that honestly in /api/health under `persistence.stateWritable`.
#
# On Render Free there is no persistent disk, so use DATABASE_URL instead.
STATE_DIR="MY_PERSISTENT_DATA_DIR"

# DATABASE_URL: External Postgres connection (compatible with Neon Free).
# When set, ALL server state moves off the local file into a single Postgres
# key/value table (JSONB): workspace, encrypted platform tokens, session
# revocations, and the AI usage guard. This is what makes state survive
# redeploys on Render Free, where the local filesystem is ephemeral.
# When unset, the server falls back to the local file and /api/health reports
# `persistence.mode: "ephemeral"` with an explicit warning instead of claiming
# durability. Server-side only; never exposed to the frontend and never logged.
# Example: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=""

# GHARABI_PREVIEW_TOKEN: OPTIONAL, disabled by default. Enables the
# /api/auth/preview-login route that mints a durable owner session, so a single
# bookmarked link signs the owner in with no OTP. While unset the route answers
# 404 as if it did not exist. The route is POST-only and reads the token from
# the JSON body ({ "token": "..." }); a token in the query string is rejected
# with 400 so it can never reach the access logs. The UI reads the token from
# the URL fragment (#preview_token=...) — never the query string — and strips it
# right after login. Generate a long random value and treat this link like a
# password. Rotating it invalidates every previously issued preview session.
# Leave it UNSET for the normal gallery deployment: the permanent owner access
# path is the OTP login above, which now yields a durable session (survives
# restarts and redeploys).
GHARABI_PREVIEW_TOKEN=""

# ---------------------------------------------------------------------------
# TikTok real connector (Login Kit + Content Posting API + Display API).
# Names only below — never put real values in the repository.
# ---------------------------------------------------------------------------
# TIKTOK_CLIENT_KEY / TIKTOK_CLIENT_SECRET: TikTok for Developers app credentials
# (Basic information). Used for /v2/auth/authorize/ (client_key) and the token
# exchange/refresh/revoke on /v2/oauth/token/. PKCE is mandatory. The client
# secret is also the HMAC key that verifies inbound TikTok-Signature webhooks
# (t=<ts>,s=<hmac-sha256(client_secret, ts + '.' + rawBody)>), so it never leaves
# the server. Server-side only; never exposed to the frontend and never logged.
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
# TIKTOK_OAUTH_SCOPES: Optional comma override of the OAuth scopes. Only scopes
# that map to an implemented, official capability are accepted
# (user.info.basic, video.publish, video.upload, video.list); any other name is
# ignored, and the required set is always included, so the connector can never
# request a scope with no matching API call. Leave empty for the built-in
# required set. Note: video.publish covers Direct Post, video.upload covers the
# draft/inbox upload — both are needed because they are separate endpoints.
TIKTOK_OAUTH_SCOPES=""
# TIKTOK_API_BASE: Optional override of the Open API base URL
# (https://open.tiktokapis.com). Test-only; never point production at a fake host.
#
# TIKTOK_VERIFICATION_TOKEN: Optional override of the TikTok URL-prefix
# verification token (the value of `signature`/`file_name` from the developer
# portal, e.g. `djxlJcC4WFlCh4OZY8iVHgezp491vPoZ`). The server serves
# `tiktok<token>.txt` with content `tiktok-developers-site-verification=<token>`.
# Set this if TikTok issues a NEW token when you re-add the URL prefix property,
# so the correct file is served without a code change. A request for any other
# `tiktok*.txt` name is rejected 404 (never a wrong signature). Public by design,
# not a secret: TikTok fetches it openly. Leave empty to use the bundled token.
TIKTOK_VERIFICATION_TOKEN=""

# TIKTOK_VERIFICATION_ECHO: Opt-in echo fallback. Default (false/empty) is the
# STRICT mode: only the canonical token above is served; any other `tiktok*.txt`
# name returns 404, which proves the canonical token alone satisfies TikTok. Set
# to `true` only to temporarily serve the signature matching whatever token name
# TikTok requests (covers a freshly regenerated token without an env change).
TIKTOK_VERIFICATION_ECHO="false"

# ---------------------------------------------------------------------------
# Facebook real connector (Facebook Pages only, never the personal account).
# Names only below — never put real values in the repository.
# ---------------------------------------------------------------------------
# FACEBOOK_OAUTH_CLIENT_ID / FACEBOOK_OAUTH_CLIENT_SECRET: Meta App OAuth
# credentials used to start /oauth/start and exchange the code in /oauth/callback.
FACEBOOK_OAUTH_CLIENT_ID=""
FACEBOOK_OAUTH_CLIENT_SECRET=""
# FACEBOOK_APP_SECRET: Meta App Secret. Used to verify the X-Hub-Signature-256
# HMAC on every inbound webhook (computed over the raw body). Server-side only.
FACEBOOK_APP_SECRET=""
# FACEBOOK_VERIFY_TOKEN: The verification token you set in the Meta App webhook
# subscription; compared in constant time on the GET hub.challenge handshake.
FACEBOOK_VERIFY_TOKEN=""
# FACEBOOK_GRAPH_VERSION: Optional Graph API version (defaults to a pinned GA
# version in engine/social/facebook.ts). FACEBOOK_SUBSCRIBED_FIELDS: Optional
# comma list of page webhook fields (defaults to feed + messages).
FACEBOOK_GRAPH_VERSION=""
FACEBOOK_SUBSCRIBED_FIELDS=""
# FACEBOOK_OAUTH_SCOPES: Optional comma override of the OAuth scopes. When set,
# the app automatically re-adds Meta's documented dependencies for any permission
# you list (for example pages_manage_engagement pulls in pages_read_user_content),
# so a partial override can never trigger "Invalid Scopes" or silently drop a
# permission. Leave empty to use the built-in required set, which already covers
# every implemented capability: publish, comment read/reply, Messenger, webhook
# subscription, Page listing, and Business-Manager pages (business_management,
# required since Graph v17 for /me/accounts). Override only if Meta rejects a
# specific scope; the redirect and gap are reported by /oauth/setup.
FACEBOOK_OAUTH_SCOPES=""
# FACEBOOK_LOGIN_CONFIG_ID: Facebook Login for Business Configuration ID (digit
# only). When set, the server sends `config_id` INSTEAD of `scope` to Meta (the
# configuration carries the permissions and asset-sharing steps), and it does not
# send both. Leave empty to fall back to the classic scope parameter. Copy it from
# Meta App Dashboard → Facebook Login for Business → Configurations. Never put the
# value in the repository, logs, or any API response.
FACEBOOK_LOGIN_CONFIG_ID=""
# META_ALLOW_SCOPE_WITHOUT_CONFIG: Optional explicit bypass of the "Business Login
# requires config_id" block. Leave empty for the safe default (block with an
# actionable 409 when Meta routes the dialog to Business Login while the code
# sends scope without config_id). Set to "true" only when Meta is proven to cover
# the permissions via the Use Case. Never put a secret here.
META_ALLOW_SCOPE_WITHOUT_CONFIG=""

# Instagram real connector (Instagram API with Facebook Login — the Meta app
# above, reused; never the personal account). A Professional account
# (Business/Creator) linked to a managed Facebook Page is required.
#
# INSTAGRAM_OAUTH_CLIENT_ID / INSTAGRAM_OAUTH_CLIENT_SECRET: Optional dedicated
# app credentials. When empty, the Facebook app id/secret above are reused, so no
# extra Render variable is needed for the default setup.
INSTAGRAM_OAUTH_CLIENT_ID=""
INSTAGRAM_OAUTH_CLIENT_SECRET=""
# INSTAGRAM_APP_SECRET: webhook signature secret. Falls back to FACEBOOK_APP_SECRET.
INSTAGRAM_APP_SECRET=""
# INSTAGRAM_VERIFY_TOKEN: webhook challenge token. Falls back to FACEBOOK_VERIFY_TOKEN.
INSTAGRAM_VERIFY_TOKEN=""
# INSTAGRAM_SUBSCRIBED_FIELDS: Optional comma list of Page webhook fields
# (defaults to "comments,messages"). INSTAGRAM_GRAPH_VERSION: Optional Graph
# version (falls back to FACEBOOK_GRAPH_VERSION).
INSTAGRAM_SUBSCRIBED_FIELDS=""
INSTAGRAM_GRAPH_VERSION=""
# INSTAGRAM_OAUTH_SCOPES: Optional comma override of the OAuth scopes. When set,
# missing dependencies are added automatically (for example
# instagram_manage_comments pulls in pages_read_engagement and pages_manage_metadata),
# so a partial override can never trigger "Invalid Scopes" or silently drop a
# permission. Leave empty to use the built-in required set (Instagram API with
# Facebook Login scope names: instagram_basic, instagram_content_publish,
# instagram_manage_comments, instagram_manage_messages, instagram_manage_insights,
# pages_show_list, pages_read_engagement, pages_manage_metadata). Override only
# if Meta rejects a specific scope; the redirect and gap are reported by /oauth/setup.
INSTAGRAM_OAUTH_SCOPES=""
# INSTAGRAM_OAUTH_ONBOARDING: Enables Meta's unified onboarding window
# (display=page + extras={"setup":{"channel":"IG_API_ONBOARDING"}} +
# response_type=token), which is the documented flow for
# "Facebook Login for Business - Instagram API". Default: enabled.
# Set to "false" to fall back to the regular code flow
# (response_type=code + /me/accounts?fields=instagram_business_account) if Meta's
# onboarding dialog fails after login with the known "Sorry, something went wrong"
# page (GraphQL error 1850019 "error during business onboarding flow"). This is a
# configuration change only - no code change or redeploy of new code is required.
INSTAGRAM_OAUTH_ONBOARDING=""
# INSTAGRAM_LOGIN_CONFIG_ID: Facebook Login for Business Configuration ID to use
# for Instagram (digit only). Highest priority, then FACEBOOK_LOGIN_CONFIG_ID.
# When set, the server sends `config_id` instead of `scope` to Meta and drops
# extras/display (the Configuration defines the permissions and the login UX).
# REQUIRED for a Meta "Business" type app: such apps route scope-bearing dialogs
# to the Business Login surface, which reads permissions from a Configuration — not
# from `scope` — and fails after login with the generic "Sorry, something went
# wrong" page when no config_id is present.
# Never put the value in the repository, logs, or any API response.
INSTAGRAM_LOGIN_CONFIG_ID=""

# RESEND_API_KEY: Required to deliver the owner login OTP by email.
# Server-side only; never exposed to the frontend bundle and never logged.
RESEND_API_KEY="MY_RESEND_API_KEY"

# RESEND_FROM_EMAIL: The verified sender address allowed by your Resend domain.
# Example: "معرض الغرابي <no-reply@yourdomain.com>"
RESEND_FROM_EMAIL="MY_VERIFIED_SENDER"

# ─────────────────────────────────────────────────────────────────────────────
# منظومة التعافي الكامل (DR) — Google Drive
# نطاق OAuth: drive.file حصراً (لا drive الكامل). التفويض منفصل عن تسجيل الدخول.
# ─────────────────────────────────────────────────────────────────────────────
# DRIVE_OAUTH_CLIENT_ID / DRIVE_OAUTH_CLIENT_SECRET: اعتماد OAuth لتطبيق Google
# Drive المستقل (Drive API مفعّل). من Google Cloud Console. لا تُكتب في Git.
DRIVE_OAUTH_CLIENT_ID=""
DRIVE_OAUTH_CLIENT_SECRET=""
# DRIVE_TOKEN_ENCRYPTION_KEY: 32 بايت (hex أو Base64) لتشفير رمز تجديد Drive
# (AES-256-GCM) قبل حفظه. لا تُدوَّر بلا سبب. لا تُسجَّل ولا تُعاد في أي استجابة.
DRIVE_TOKEN_ENCRYPTION_KEY=""
# DR_RECOVERY_MASTER_KEY: المفتاح الرئيسي لفكّ حزمة الأسرار (secrets.enc) ونسخة
# قاعدة البيانات (database.enc). إن غاب يُستخدم DRIVE_DB_BACKUP_KEY ثم
# DRIVE_TOKEN_ENCRYPTION_KEY. 32 بايت (hex أو Base64). احفظه خارج الخادم أيضاً:
# بدونه لا يمكن فكّ الأسرار بعد كارثة. لا يُدرج داخل أي نسخة.
DR_RECOVERY_MASTER_KEY=""
# DRIVE_DB_BACKUP_KEY: مفتاح تشفير نسخة قاعدة البيانات (اختياري إن ضُبط المفتاح الرئيسي).
DRIVE_DB_BACKUP_KEY=""
# DR_RECOVERY_VAULT_KEY: مفتاح **خزنة مفاتيح الطوارئ** (KEY-VAULT/) المستقل تماماً عن
# المفاتيح أعلاه. 32 بايت (hex أو Base64). يفتح KEY-VAULT/current.enc وحدها.
# لا يُحفظ داخل Google Drive ولا داخل أي نسخة — احفظ نسخة منه في مكان آمن مستقل.
DR_RECOVERY_VAULT_KEY=""
# DR_RECOVERY_TEST_DATABASE_URL: قاعدة بيانات **معزولة** لاختبار الاستعادة فقط.
# تُرفض تلقائياً إن طابقت DATABASE_URL الإنتاجي. لا تُستخدم قاعدة الإنتاج في الاختبار.
DR_RECOVERY_TEST_DATABASE_URL=""
# DR_AUTO_BACKUP_INTERVAL_MS: فاصل النسخة الكاملة التلقائية (Recovery Point).
# افتراضياً 21600000 (6 ساعات). حدّان آمنان: 60000 (دقيقة) .. 86400000 (24 ساعة)؛
# أي قيمة غائبة/غير صالحة تُعاد إلى 6 ساعات. النسخة تعمل على الخادم بلا متصفح.
DR_AUTO_BACKUP_INTERVAL_MS=""
# DR_RETENTION_KEEP: عدد نقاط الاستعادة **المكتملة** المحفوظة (افتراضياً 3، حدود 1..50).
# التقليم يقع فقط بعد نجاح نسخة جديدة والتحقق منها، ولا يُنفَّذ قبل اكتمالها.
DR_RETENTION_KEEP=""
# DR_RETENTION_PROTECTED_IDS: معرّفات نقاط لا تُحذف أبداً (مفصولة بفواصل).
# الافتراضي rp-002,rp-003,rp-004 (النسخ الأصلية محميّة). لا تُحذف النقطة الأحدث ولا الناقصة.
DR_RETENTION_PROTECTED_IDS=""
# DR_AUTO_RETENTION: false لتعطيل التقليم التلقائي كلياً (افتراضاً مفعّل).
DR_AUTO_RETENTION=""
# ===== مركز استعادة الغرابي AI (خدمة مستقلة) =====
# خدمة `dr-recovery-center/` تُنشر منفصلة عن Render الرئيسي فتبقى متاحة عند فقدان
# تطبيق الغرابي/جلسته. تستخدم نفس اعتماد Drive أعلاه + مفتاح فكّ الأسرار/القاعدة.
# RECOVERY_CENTER_HOSTED: true على الاستضافة (يستمع على 0.0.0.0)، وإلا محلياً 127.0.0.1.
RECOVERY_CENTER_HOSTED=""
# RECOVERY_CENTER_PORT: منفذ المركز المستقل (افتراضياً 4600).
RECOVERY_CENTER_PORT=""
# ملاحظة: DR_RECOVERY_VAULT_KEY **لا يُضبط في بيئة المركز** — يُدخله المالك في الواجهة فقط.
# لا يُوضع في Google Drive ولا GitHub ولا الاختصار ولا secrets.enc ولا السجلات.
